# ============================================================
# Brevan Softwares - environment template (committed example)
# Copy to .env (or use in Vercel) and fill in the secrets.
# Commit-friendly: no secrets are stored in this file.
# ============================================================

# ---- Site ------------------------------------------------------
# Canonical URL used for sitemap, metadata and Open Graph.
NEXT_PUBLIC_SITE_URL=https://brevansoftwares.co.ke

# Google Tag Manager container ID (head script + noscript iframe).
NEXT_PUBLIC_GTM_ID=GTM-NZZFG3MW

# WhatsApp number in international format (digits only, no +).
NEXT_PUBLIC_WHATSAPP_NUMBER=254117004147

# Client portal base URL (header "Client Portal" + CTA "Start Application").
NEXT_PUBLIC_CLIENT_PORTAL_URL=https://clients.brevansoftwares.co.ke

# Events / booking portal base URL (/events page).
NEXT_PUBLIC_EVENTS_PORTAL_URL=https://events.brevansoftwares.co.ke

# ---- Supabase ----------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public key - safe for the browser. The site accepts BOTH the legacy
# name (anon public JWT) and the new one (publishable key sb_publishable_*).
# New projects only: set NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# Legacy projects only: set NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role / secret key - SERVER ONLY. Run supabase/schema.sql first.
# New projects: secret key (sb_secret_*) | Legacy: service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ---- Email (Resend) ----------------------------------------------
# Optional email delivery (falls back to database-only logging).
RESEND_API_KEY=

# Where owner notifications for new quote/contact requests go.
CONTACT_EMAIL=brevansoftwares@gmail.com

# From address - must be a verified sending domain in Resend.
EMAIL_FROM="Brevan Softwares <onboarding@resend.dev>"